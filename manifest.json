{
  "action": {
    "default_popup": "popup.html",
    "default_title": "NeuralReader V3.4"
  },
  "author": "Joseph Rocco Peransi",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "read_selection": {
      "description": "Read selection",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "description": "Local-first Audio Interface. Architected by Joseph Rocco Peransi.",
  "host_permissions": [
    "<all_urls>"
  ],
  "manifest_version": 3,
  "name": "NeuralReader | Sovereign Core",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tts",
    "storage",
    "audioCapture",
    "contextMenus",
    "windows"
  ],
  "version": "3.4"
}
